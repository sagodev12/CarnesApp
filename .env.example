# ============================================
# SUPABASE
# Dashboard: https://supabase.com/dashboard/project/_/settings/api-keys
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor — nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# AUTH0
# Dashboard: https://manage.auth0.com/dashboard
# ============================================
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Cifra la cookie de sesión. En producción genera uno propio: openssl rand -hex 32
AUTH0_SECRET=

# Correos con acceso al panel /admin (separados por comas)
ADMIN_EMAILS=

# ============================================
# NEGOCIO (opcional — si prefieres algo fijo por env
# en vez de guardarlo en site_config dentro de Supabase)
# ============================================
NEXT_PUBLIC_WHATSAPP_NUMBER=
